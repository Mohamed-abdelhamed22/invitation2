# Required environment variables for Netlify (set in Netlify dashboard:
# Site settings > Environment variables). The functions read these at runtime.

# Your Supabase project URL (Settings > API)
SUPABASE_URL=https://ckqfaidfxpmqubbbwgib.supabase.co

# Your Supabase public / publishable key (Settings > API). This project uses
# a publishable key, which works for inserting and reading the messages table.
SUPABASE_ANON_KEY=sb_publishable_xxx

# The wedding the messages belong to (from the `weddings` table -> id)
WEDDING_ID=b56f980e-20bf-4c43-98e7-11fe606b5ad9

# Secret the admin page must send to read messages.
# Must match the PASSWORD value in admin.html.
ADMIN_TOKEN=your_admin_token_here
